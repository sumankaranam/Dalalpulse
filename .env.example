# Gemini API Key for synthesis brief
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Supabase (Next.js client-facing variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Local Worker Storage & Hardware Paths
LOCAL_MODEL_DIR=C:\models
LOCAL_DUCKDB_PATH=worker/data/local_cache.duckdb
GGUF_MODEL_FILENAME=Qwen2.5-3B-Instruct-Q4_K_M.gguf

# Reddit API Credentials (for ingest.py)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DalalPulseWorker/1.0

# Telegram Alerting (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
